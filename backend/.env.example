# ==============================================================================
# SOL ECOSYSTEM - Environment Variables Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=sol_ecosystem_super_secure_jwt_secret_2026_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sol_db
DB_USER=postgres
DB_PASSWORD=postgres_password_here
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Client Application URL (CORS)
CLIENT_URL=http://localhost:3000
