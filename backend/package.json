{
  "name": "sol-ecosystem-backend",
  "version": "1.0.0",
  "description": "Production-Ready RESTful API for SOL Ecosystem (Smart Agriculture & Livestock Management Platform)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "psql -U postgres -d sol_db -f schema.sql",
    "db:seed": "psql -U postgres -d sol_db -f seed.sql",
    "db:verify": "psql -U postgres -d sol_db -f verify_and_report.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
